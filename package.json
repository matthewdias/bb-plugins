{
  "name": "bb-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "description": "BB plugins: Follow Up, Question Dock, Swipe Controls, Thread Badges, Top Tabs, and Workflow Stages.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewdias/bb-plugins.git"
  },
  "workspaces": [
    "plugins/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "npm run --workspaces --if-present typecheck",
    "test": "npm run --workspaces --if-present test",
    "build": "npm run --workspaces --if-present build",
    "check": "node scripts/check-vendored.mjs && npm run typecheck && npm run test && npm run build",
    "bb": "node scripts/bb-dev.mjs",
    "plugins": "node scripts/bb-dev.mjs status",
    "link": "node scripts/bb-dev.mjs link",
    "release": "node scripts/bb-dev.mjs release"
  }
}
