{
  "name": "bb-plugin-thread-summary",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "keywords": [
    "bb-plugin",
    "complications",
    "git",
    "pull-requests",
    "threads"
  ],
  "homepage": "https://github.com/matthewdias/bb-plugins/tree/main/plugins/thread-summary#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/matthewdias/bb-plugins.git",
    "directory": "plugins/thread-summary"
  },
  "bugs": {
    "url": "https://github.com/matthewdias/bb-plugins/issues"
  },
  "engines": {
    "bb": ">=0.45",
    "bbPluginSdk": ">=0.6.15"
